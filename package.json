{
	"name": "@bryanjhv/drischpe",
	"type": "module",
	"version": "0.0.0",
	"private": true,
	"license": "AGPL-3.0-or-later",
	"scripts": {
		"build": "npm run typecheck && vite build",
		"typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
		"lint": "eslint --fix",
		"start": "vite",
		"pull-data": "node --env-file-if-exists=.env scripts/pull-mtc.ts && node scripts/build-data.ts",
		"geocode": "node scripts/add-geocode.ts"
	},
	"dependencies": {
		"alpinejs": "3.17.5",
		"leaflet": "1.9.4",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@antfu/eslint-config": "9.5.1",
		"@tsconfig/node-ts": "23.6.4",
		"@tsconfig/node24": "24.0.5",
		"@tsconfig/strictest": "2.0.8",
		"@tsconfig/vite-react": "8.1.1",
		"@types/alpinejs": "3.17.0",
		"@types/leaflet": "1.9.22",
		"@types/node": "24.19.2",
		"eslint": "10.14.0",
		"eslint-plugin-format": "2.0.1",
		"typescript": "6.0.3",
		"vite": "8.3.5"
	}
}
